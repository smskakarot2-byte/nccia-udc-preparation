# ---------------------------------------------------------------------------
# NCCIA UDC Preparation — environment configuration
# Copy this file to .env and fill in real values. Never commit .env.
# ---------------------------------------------------------------------------

# Database
# Default (easiest local setup): SQLite, no server required.
DATABASE_URL="file:./dev.db"
# For production, switch prisma/schema.prisma's datasource provider to
# "postgresql" and point this at a real Postgres instance instead, e.g.:
# DATABASE_URL="postgresql://user:password@localhost:5432/nccia_udc?schema=public"

# Admin authentication
# Generate a bcrypt hash for ADMIN_PASSWORD_HASH with:
#   node -e "console.log(require('bcryptjs').hashSync('choose-a-strong-password', 10))"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD_HASH="$2a$10$replace_with_a_real_bcrypt_hash_generated_locally"

# Session signing secret (any long random string). Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET="replace_with_a_long_random_string"

# Extraction engine
# Comma-separated list of source keys to enable at startup (all 15 are
# registered either way; this only controls their initial enabled/disabled
# state, which admins can also change from /admin/sources).
ENABLED_SOURCES="demo"

# Optional: AI relevance classification (section 19 of the spec).
# Entirely optional and off by default — the rule-based relevance filter
# (src/lib/relevance-filter.ts) runs regardless and is what the app relies
# on out of the box. If you want an LLM double-check layer, set this to
# an Anthropic API key and AI_RELEVANCE_ENABLED=true.
AI_RELEVANCE_ENABLED="false"
ANTHROPIC_API_KEY=""

# Base URL the app is served from (used for absolute links in exports/emails)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
